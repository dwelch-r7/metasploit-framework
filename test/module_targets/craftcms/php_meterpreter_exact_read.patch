+# C2 framing needs an exact read: the channel read helper may return an empty
+# string while an open stream is waiting for the next part of a packet.
+# Keep its nonblocking channel contract unchanged and wait only on the C2 socket.
+function read_c2_bytes($resource, $length, $deadline) {
+  if ($length < 0) { return false; }
+  $buffer = '';
+  while (strlen($buffer) < $length) {
+    $remaining = $deadline - microtime(true);
+    if ($remaining <= 0) { return false; }
+    $wait = min(1, $remaining);
+    $seconds = (int)$wait;
+    $microseconds = ($seconds === 0) ? max(1, (int)($wait * 1000000)) : 0;
+    $readers = array($resource);
+    $writers = null; $errors = null;
+    $count = select($readers, $writers, $errors, $seconds, $microseconds);
+    if ($count === false) { return false; }
+    if ($count === 0) { continue; }
+
+    $needed = $length - strlen($buffer);
+    switch (get_rtype($resource)) {
+      case 'socket':
+        $chunk = socket_read($resource, $needed, PHP_BINARY_READ);
+        break;
+      case 'stream':
+        $chunk = fread($resource, $needed);
+        break;
+      default:
+        return false;
+    }
+    if ($chunk === false || $chunk === '') { return false; }
+    $buffer .= $chunk;
+  }
+  return $buffer;
+}
